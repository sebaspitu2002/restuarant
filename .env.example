# Copia este archivo a .env.local y rellena los valores. Nunca subas .env.local.

# Cliente cuya config se carga (clients/<slug>.ts)
CLIENT_SLUG=

# URL pública del despliegue, sin barra final (enlaces mágicos, emails, Stripe)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase (Project Settings → API)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Solo servidor: salta RLS. Nunca con prefijo NEXT_PUBLIC_
SUPABASE_SERVICE_ROLE_KEY=

# Firma de tokens y hash de códigos de tarjeta regalo (openssl rand -hex 32)
HMAC_SECRET=

# Stripe (cuenta del cliente)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Resend
RESEND_API_KEY=
EMAIL_FROM=
